DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shop_sys

# Meta App settings (developers.facebook.com)
META_APP_SECRET=
META_APP_ID=
META_VERIFY_TOKEN=changeme-random-string
# Used to retrieve a Messenger sender's profile name from their PSID.
META_PAGE_ACCESS_TOKEN=
META_IG_ACCESS_TOKEN=
# Required only for the “Connect Facebook Page” button. The redirect URI must
# exactly match the URI configured in Meta App Dashboard.
META_OAUTH_REDIRECT_URI=
META_OAUTH_FRONTEND_URL=
# Public frontend origin only, e.g. https://app.example.com (no /facebook).
META_PUBLIC_WEB_URL=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
META_TOKEN_ENCRYPTION_KEY=

# Separate read-only token for Facebook history analysis. This module never
# sends messages. PAGE_ID is optional when the token can resolve its Page.
META_HISTORY_ACCESS_TOKEN=
META_HISTORY_PAGE_ID=
META_HISTORY_LOOKBACK_DAYS=60

# LINE Official Account (developers.line.biz) -- used to verify
# X-Line-Signature on incoming webhooks. Find it under your channel's
# "Messaging API" tab as "Channel secret".
LINE_CHANNEL_SECRET=

# Comma-separated origins allowed to call this API (Next.js dev server)
CORS_ORIGINS=http://localhost:3000
